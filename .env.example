# --- Upstash Redis (primary database) ---
# Create a free database at https://console.upstash.com and copy the REST credentials.
# On Vercel, adding the Upstash integration (Storage tab) sets these for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Translation / vocabulary assistance (optional) ---
# Without these the app still works; only the "Translate" assistant is disabled.
# TRANSLATION_PROVIDER: "gemini" (Google AI Studio, has a free tier) or "openai"
# ("openai" speaks the OpenAI chat-completions protocol, so it also covers Groq,
# OpenRouter, Together and other compatible services via TRANSLATION_BASE_URL).
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
# Optional overrides
TRANSLATION_MODEL=
TRANSLATION_BASE_URL=
